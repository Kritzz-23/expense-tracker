# Backend environment configuration
# Copy this file to `.env` in the backend folder and fill in the values.

# Required for AI expense categorization, AI insight summaries, and the AI chat.
# Get it from https://console.groq.com
GROQ_API_KEY=

# Secret used to sign JWT tokens. Use a long random string in production.
SECRET_KEY=change-me-to-a-long-random-string

# Database connection string. Leave unset to use local SQLite (backend/finance.db).
# On Render this is injected automatically as a Postgres connection string.
# DATABASE_URL=

# Optional: comma-separated list of allowed CORS origins. Leave unset to allow all origins.
# CORS_ORIGINS=
